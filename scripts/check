#!/usr/bin/env python3
"""Check every part: the Blender extension's tests, then the Apple app's formatting, build and tests."""

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "apple/scripts"))
sys.dont_write_bytecode = True

import preflight  # noqa: E402


def display(output):
    output = preflight.mask(output)
    team = os.environ.get("LAUDER_DEVELOPMENT_TEAM")
    if team:
        output = output.replace(team, "<signing-team>")
    destination_id = re.search(r"(?:^|,)id=([^,]+)", os.environ.get("LAUDER_DESTINATION", ""))
    if destination_id:
        output = output.replace(destination_id[1], "<device-id>")
    print(output, end="", flush=True)


def run(command, log):
    with log.open("w") as stream:
        result = subprocess.run(command, cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT)
    display(log.read_text(errors="replace"))
    if result.returncode:
        raise SystemExit(result.returncode)


def simulator_destination():
    device = preflight.iphone_simulator()
    display(f"Testing on {device['name']} using an available iOS simulator.\n")
    return f"platform=iOS Simulator,id={device['udid']}"


def main():
    preflight.check_assets()
    output = Path(tempfile.mkdtemp(prefix="lauder-check-"))
    try:
        print("Checking shared source declarations.", flush=True)
        run(
            [sys.executable, "-I", "-B", "apple/scripts/contracts.py"],
            output / "contracts.log",
        )
        run(
            [sys.executable, "-I", "-B", "apple/scripts/test-contracts.py"],
            output / "contract-tests.log",
        )
        print("Checking TestFlight release contracts.", flush=True)
        run(
            [sys.executable, "-I", "-B", "apple/scripts/test-testflight-release.py"],
            output / "release-contracts.log",
        )
        print("Checking Simulator recording lifecycle.", flush=True)
        run(
            [sys.executable, "-I", "-B", "apple/scripts/test-playtest-recording.py"],
            output / "recording.log",
        )
        print("Running the Blender extension's tests.", flush=True)
        run(
            [sys.executable, "-I", "-B", "blender/test_lauder_levels.py"],
            output / "blender-levels.log",
        )
        print("Checking the generated combat sounds.", flush=True)
        run(
            [sys.executable, "-I", "-B", "apple/scripts/make-sounds.py", "--check"],
            output / "sounds.log",
        )
        print("Checking Swift formatting.", flush=True)
        run(
            [
                "xcrun", "swift", "format", "lint", "--strict", "--recursive",
                "apple/sources", "apple/tests",
            ],
            output / "format.log",
        )
        destination = os.environ.get("LAUDER_DESTINATION") or simulator_destination()
        command = [
            "xcodebuild",
            "-quiet",
            "-project", "apple/Lauder.xcodeproj",
            "-scheme", "Lauder",
            "-configuration", "Debug",
            "-destination", destination,
            "-derivedDataPath", str(output / "DerivedData"),
            "-resultBundlePath", str(output / "Tests.xcresult"),
            "-parallel-testing-enabled", "NO",
            "test",
        ]
        if "platform=iOS Simulator" in destination:
            command.append("CODE_SIGNING_ALLOWED=NO")
        elif os.environ.get("LAUDER_DEVELOPMENT_TEAM"):
            command.append("DEVELOPMENT_TEAM=" + os.environ["LAUDER_DEVELOPMENT_TEAM"])
        print("Building and running Swift Testing tests.", flush=True)
        run(command, output / "xcodebuild.log")
    except BaseException:
        print(
            f"Check failed. Logs and any build/test results are retained locally at {output}.",
            file=sys.stderr,
        )
        raise
    shutil.rmtree(output)
    print("Checks passed. Temporary build and test output removed.", flush=True)


if __name__ == "__main__":
    main()
