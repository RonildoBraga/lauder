#!/usr/bin/env python3
"""Run scripted playtests in the iOS Simulator and report what happened.

Builds the Debug app, launches it with `-LauderPlaytest <scenario>`, records the screen,
screenshots every marked moment as it happens, then collects the run's summary and trace. The scenarios
live in sources/world/Playtest.swift. Results go to .local/playtest/<time>/ unless --output is
given; that folder is ignored by Git.

    ./scripts/playtest                 # every scenario, one after another
    ./scripts/playtest first-fight ambush
    ./scripts/playtest --list
"""

import argparse
import datetime
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
BUNDLE = "com.ronildo.lauder"
SCENARIOS = ["bridge-walk", "first-fight", "fight-retry", "ambush"]
PRIVATE_IDENTIFIER = re.compile(
    r"\b(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}|[0-9a-f]{8}-[0-9a-f]{16})\b",
    re.IGNORECASE,
)


def say(message):
    print(PRIVATE_IDENTIFIER.sub("<device-id>", message), flush=True)


def run(command, **options):
    return subprocess.run(command, capture_output=True, text=True, **options)


def check_assets():
    for name in ("Idle", "Walk"):
        path = ROOT / "sources/content/character" / f"{name}.usdz"
        with path.open("rb") as stream:
            if stream.read(128).startswith(b"version https://git-lfs.github.com/spec/v1"):
                raise SystemExit(f"{path.relative_to(ROOT)} is a Git LFS pointer; run 'git lfs pull'.")


def simulator():
    """The device named by LAUDER_DESTINATION, else a booted iOS 27+ iPhone, else any."""
    match = re.search(r"(?:^|,)id=([^,]+)", os.environ.get("LAUDER_DESTINATION", ""))
    if match:
        return match[1]
    result = run(["xcrun", "simctl", "list", "devices", "available", "--json"])
    if result.returncode:
        raise SystemExit("Unable to list simulators.")
    candidates = []
    for runtime, devices in json.loads(result.stdout)["devices"].items():
        version = re.fullmatch(r"com\.apple\.CoreSimulator\.SimRuntime\.iOS-(\d+)-(\d+)(?:-(\d+))?", runtime)
        if not version or int(version[1]) < 27:
            continue
        for device in devices:
            if device.get("isAvailable") and device["name"].startswith("iPhone"):
                rank = (device["state"] != "Booted", device["name"], device["udid"])
                candidates.append((rank, device["udid"]))
    if not candidates:
        raise SystemExit("Install an iOS 27 or later iPhone simulator runtime in Xcode first.")
    return min(candidates)[1]


def build(device, derived):
    say("Building the Debug app.")
    result = run([
        "xcodebuild", "-quiet", "-project", "Lauder.xcodeproj", "-scheme", "Lauder",
        "-configuration", "Debug", "-destination", f"platform=iOS Simulator,id={device}",
        "-derivedDataPath", str(derived), "build", "CODE_SIGNING_ALLOWED=NO",
    ], cwd=ROOT)
    if result.returncode:
        say(result.stdout[-4000:] + result.stderr[-4000:])
        raise SystemExit("Build failed.")
    return derived / "Build/Products/Debug-iphonesimulator/Lauder.app"


def boot(device):
    run(["xcrun", "simctl", "boot", device])
    if run(["xcrun", "simctl", "bootstatus", device, "-b"]).returncode:
        raise SystemExit("The simulator did not finish booting.")


def start_recording(device, video):
    recorder = subprocess.Popen(
        ["xcrun", "simctl", "io", device, "recordVideo", "--codec=h264", "--force", str(video)],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    deadline = time.time() + 15
    while time.time() < deadline:
        line = recorder.stdout.readline()
        if "Recording started" in line:
            return recorder, time.time()
        if recorder.poll() is not None:
            break
    recorder.send_signal(signal.SIGINT)
    raise SystemExit("Screen recording did not start.")


def stop_recording(recorder):
    recorder.send_signal(signal.SIGINT)
    try:
        recorder.wait(timeout=30)
    except subprocess.TimeoutExpired:
        recorder.kill()


def documents(device):
    result = run(["xcrun", "simctl", "get_app_container", device, BUNDLE, "data"])
    if result.returncode:
        raise SystemExit("Lauder is not installed on the simulator.")
    return Path(result.stdout.strip()) / "Documents/playtest"


def capture(device, mark, number, scenario, folder):
    """Screenshot the simulator now, turned upright for a landscape app."""
    _, orientation, name = mark
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    path = folder / f"{scenario}-{number:02d}-{slug}.jpg"
    raw = folder / f".{scenario}-{number:02d}.png"
    if run(["xcrun", "simctl", "io", device, "screenshot", "--type=png", str(raw)]).returncode:
        return None
    # Screenshots normally follow the interface orientation already; turn one only if it came
    # out in portrait while the app runs in landscape. sips rotates clockwise.
    size = run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(raw)]).stdout
    width = int(re.search(r"pixelWidth: (\d+)", size)[1]) if "pixelWidth" in size else 0
    height = int(re.search(r"pixelHeight: (\d+)", size)[1]) if "pixelHeight" in size else 0
    turn = []
    if height > width:
        turn = {"landscapeRight": ["-r", "270"], "landscapeLeft": ["-r", "90"]}.get(orientation, [])
    result = run(["sips", "-s", "format", "jpeg", *turn, str(raw), "--out", str(path)])
    raw.unlink(missing_ok=True)
    return path if result.returncode == 0 else None


def play(device, scenario, folder, timeout):
    run(["xcrun", "simctl", "terminate", device, BUNDLE])
    results = documents(device) / scenario
    shutil.rmtree(results, ignore_errors=True)
    video = folder / f"{scenario}.mp4"
    images = []
    recorder, _ = start_recording(device, video)
    say(f"Playing {scenario}.")
    try:
        launched = run(["xcrun", "simctl", "launch", device, BUNDLE, "-LauderPlaytest", scenario])
        if launched.returncode:
            raise SystemExit(f"Launch failed: {launched.stderr.strip()}")
        summary_file = results / "summary.json"
        marks_file = results / "marks.log"
        deadline = time.time() + timeout
        seen = 0

        def capture_new_marks():
            # Screenshot each marked moment as the app announces it.
            nonlocal seen
            if not marks_file.exists():
                return
            lines = [line.split("\t", 2) for line in marks_file.read_text().splitlines()]
            for mark in lines[seen:]:
                if len(mark) == 3:
                    image = capture(device, mark, len(images) + 1, scenario, folder)
                    if image:
                        images.append(image)
            seen = len(lines)

        while not summary_file.exists():
            if time.time() > deadline:
                raise SystemExit(f"{scenario} did not finish within {timeout} s.")
            capture_new_marks()
            time.sleep(0.1)
        capture_new_marks()  # A mark in the last moments before the summary was written.
        time.sleep(1)  # Let the final frames reach the recording.
    finally:
        stop_recording(recorder)
        run(["xcrun", "simctl", "terminate", device, BUNDLE])
    summary = json.loads(summary_file.read_text())
    shutil.copy(summary_file, folder / f"{scenario}-summary.json")
    shutil.copy(results / "trace.csv", folder / f"{scenario}-trace.csv")
    return summary, images


def report(summary, images, folder):
    verdict = "PASS" if summary["passed"] else "FAIL"
    say(f"  {verdict}: {summary['scenario']}, {summary['seconds']:.1f} s, "
        f"{summary['stepsCompleted']}/{summary['steps']} steps, {summary['frames']} frames")
    for failure in summary["failures"]:
        say(f"    - {failure}")
    frame, sim = summary["frameMilliseconds"], summary["simulationMilliseconds"]
    say(f"    frame time {frame['mean']:.1f} ms mean, {frame['p99']:.1f} ms p99, {frame['max']:.1f} ms max")
    say(f"    party update {sim['mean']:.3f} ms mean, {sim['max']:.3f} ms max (Simulator, not phone)")
    say(f"    bodies overlapping {summary['overlapFraction'] * 100:.1f}% of frames; "
        f"within 0.6 m of slot while moving {summary['withinSlotWhileMoving'] * 100:.0f}%; "
        f"widest leader gap {summary['worstLeaderGap']:.2f} m")
    for image in images:
        say(f"    still: {image.relative_to(ROOT) if image.is_relative_to(ROOT) else image}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("scenarios", nargs="*", default=SCENARIOS, help="scenario names")
    parser.add_argument("--output", type=Path, help="results folder (default .local/playtest/<time>)")
    parser.add_argument("--timeout", type=int, default=300, help="seconds allowed per scenario")
    parser.add_argument("--list", action="store_true", help="list scenarios and exit")
    options = parser.parse_args()
    if options.list:
        print("\n".join(SCENARIOS))
        return
    unknown = [name for name in options.scenarios if name not in SCENARIOS]
    if unknown:
        raise SystemExit(f"Unknown scenario: {', '.join(unknown)}. Try --list.")

    check_assets()
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    folder = (options.output or ROOT / ".local/playtest" / stamp).resolve()
    folder.mkdir(parents=True, exist_ok=True)
    device = simulator()
    with tempfile.TemporaryDirectory(prefix="lauder-playtest-") as derived:
        app = build(device, Path(derived))
        boot(device)
        if run(["xcrun", "simctl", "install", device, str(app)]).returncode:
            raise SystemExit("Install failed.")
    passed = True
    for scenario in options.scenarios:
        summary, images = play(device, scenario, folder, options.timeout)
        report(summary, images, folder)
        passed = passed and summary["passed"]
    shown = folder.relative_to(ROOT) if folder.is_relative_to(ROOT) else folder
    say(f"Results in {shown}.")
    if not passed:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
